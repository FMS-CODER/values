<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    管理端分类列表。
    排序按 sort_order、id 兜底：sort_order 相同的分类也保持稳定顺序，翻页/刷新不会跳行。
-->
<mapper namespace="ming.valuesjava.mapper.CategoryAdminMapper">

    <resultMap id="CategoryRowMap" type="ming.valuesjava.repository.CategoryAdminRepository$CategoryRow">
        <constructor>
            <arg column="id" javaType="_long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="sort_order" javaType="_int"/>
            <arg column="food_count" javaType="_long"/>
        </constructor>
    </resultMap>

    <sql id="categorySelect">
        SELECT c.id, c.code, c.name, c.sort_order,
               (SELECT COUNT(*) FROM food f WHERE f.category_id = c.id) AS food_count
        FROM food_category c
    </sql>

    <select id="findAll" resultMap="CategoryRowMap">
        <include refid="categorySelect"/>
        ORDER BY c.sort_order, c.id
    </select>

    <select id="findById" resultMap="CategoryRowMap">
        <include refid="categorySelect"/>
        WHERE c.id = #{id}
    </select>

</mapper>