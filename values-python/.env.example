# 复制为 .env 后填写；.env 不要提交到 Git
# python-dotenv 已接入：启动时自动读取 values-python/.env，进程环境变量优先

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=values

# ---- USDA 原始数据（体积大，不随仓库分发）----
USDA_JSON_PATH=

# ---- 图片源（不填则使用无需 Key 的 Wikimedia Commons）----
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- AI 服务（values-python 的 FastAPI）----
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000

# ---- AI 模型（不填 Key 时服务仍可启动，回答改为直接查营养库）----
AI_PROVIDER=openai
AI_MODEL=
AI_TEMPERATURE=0.2
AI_BASE_URL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# 阿里云百炼示例：
# AI_PROVIDER=dashscope
# AI_MODEL=deepseek-v4.1-flash
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_API_KEY_ENV=DASHSCOPE_API_KEY

# ---- 向量库（Qdrant）----
QDRANT_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=nutrition_knowledge
QDRANT_API_KEY=

# ---- 检索与索引 ----
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-ngram-v1
EMBEDDING_DIM=384
RAG_TOP_K=4
RAG_MIN_SCORE=0.2
RAG_AUTO_INDEX=true
RAG_INCLUDE_PENDING=false