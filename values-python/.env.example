# 复制为 .env 后填写；.env 不要提交到 Git
# 当前脚本只读取进程环境变量，不自动加载 .env 文件；
# 需要时用 PowerShell: $env:DB_PASSWORD="..."，或自行接入 python-dotenv。

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=values

# ---- USDA 原始数据（体积大，不随仓库分发）----
USDA_JSON_PATH=

# ---- 图片源（不填则使用无需 Key 的 Wikimedia Commons）----
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- AI 服务（values-python 的 FastAPI）----
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000

# ---- AI 模型（不填 Key 时服务仍可启动，回答改为直接查营养库）----
AI_PROVIDER=openai
AI_MODEL=
AI_TEMPERATURE=0.2
AI_BASE_URL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=